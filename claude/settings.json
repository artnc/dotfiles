{
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "effortLevel": "xhigh",
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "ADB_MDNS_AUTO_CONNECT": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "8",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "/usr/bin/chromium"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "\"${HOME}\"/git/dotfiles/claude/hook-stop.sh",
            "type": "command"
          }
        ],
        "matcher": "elicitation_dialog|permission_prompt"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"${HOME}\"/git/dotfiles/claude/hook-posttooluse.py",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"${HOME}\"/git/dotfiles/claude/hook-stop.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "opus[1m]",
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "Bash(adb *)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:sts.us-east-1.amazonaws.com)"
    ],
    "defaultMode": "auto"
  },
  "sandbox": {
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "excludedCommands": [
      "adb"
    ],
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "~/.cache/mise",
        "~/.local/state/mise",
        "~/Library/Caches/mise"
      ]
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "jq -r '[(.workspace.current_dir | split(\"/\") | last), (.model.display_name | gsub(\" context\"; \"\")), ((.context_window.used_percentage // 0 | tostring) + \"% ctx\"), ((.rate_limits.five_hour // empty) as $r | (($r.resets_at - now) / 60 | floor) as $m | (if $m > 0 then $m else 0 end) as $m | ($r.used_percentage | floor | tostring) + \"% \" + (($m / 60 * 10 | round) / 10 | tostring) + \"h\"), \"$\" + (.cost.total_cost_usd * 100 | round | . / 100 | tostring)] | join(\", \")'",
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen"
}
