# Make notifications big and colorful so that I notice them. See all options:
# https://dunst-project.org/documentation/

[global]
corner_radius = 0
enable_recursive_icon_lookup = true
# Show on the monitor with keyboard focus instead of always the primary
follow = keyboard
font = Adwaita Sans 12
format = "<b>%s</b>\n%b"
frame_width = 2
gap_size = 8
horizontal_padding = 12
icon_corner_radius = 0
icon_theme = Adwaita
max_icon_size = 48
# Leave equal 12px gaps from the screen's right edge and from Waybar's bottom
# edge. Sway already places dunst below Waybar's exclusive zone, so the old 32px
# offset left 49px from the top of the screen and a 32px gap under the 17px bar
offset = (12, 12)
origin = top-right
padding = 10
# Hide the "(A)" and "(U)" title prefixes for notifications with actions or URLs
show_indicators = no
width = (200, 500)

# Use Modus Vivendi colors to match Ghostty: `bg-active`, `bg-blue-intense`, and
# `red` from `modus-themes-vivendi-palette` with white or black text for at
# least 7:1 contrast. Frames are each background darkened to 40%
# https://github.com/protesilaos/modus-themes/blob/main/modus-themes.el
[urgency_low]
background = "#535353"
foreground = "#ffffff"
frame_color = "#212121"
timeout = 3

[urgency_normal]
background = "#1640b0"
foreground = "#ffffff"
frame_color = "#091a46"
highlight = "#ffffff"
timeout = 5

# Keep critical notifications (e.g. low battery) until I dismiss them
[urgency_critical]
background = "#ff5f59"
foreground = "#000000"
frame_color = "#662624"
highlight = "#000000"
timeout = 0
