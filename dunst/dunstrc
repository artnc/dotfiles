# Make notifications big and colorful so that I notice them. See all options:
# https://dunst-project.org/documentation/

[global]
corner_radius = 0
enable_recursive_icon_lookup = true
# Show on the monitor with keyboard focus instead of always the primary
follow = keyboard
font = DejaVu Sans 12
format = "<b>%s</b>\n%b"
frame_width = 2
gap_size = 8
horizontal_padding = 12
icon_corner_radius = 0
icon_theme = Adwaita
max_icon_size = 48
# Clear Waybar at the top of the screen
offset = (12, 32)
origin = top-right
padding = 10
# Hide the "(A)" and "(U)" title prefixes for notifications with actions or URLs
show_indicators = no
width = (200, 500)

# Use Twilight colors from TextMate
# (https://github.com/textmate/themes.tmbundle/blob/master/Themes/Twilight.tmTheme)
# with Ghostty's Twilight selection gray (`#313131`). Frames are each
# background darkened to 40%
[urgency_low]
background = "#313131"
foreground = "#f8f8f8"
frame_color = "#141414"
timeout = 3

[urgency_normal]
background = "#cda869"
foreground = "#141414"
frame_color = "#52432a"
highlight = "#141414"
timeout = 5

# Keep critical notifications (e.g. low battery) until I dismiss them
[urgency_critical]
background = "#cf6a4c"
foreground = "#141414"
frame_color = "#532a1e"
highlight = "#141414"
timeout = 0
