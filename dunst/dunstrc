# Make notifications big and colorful so that I notice them. See all options:
# https://dunst-project.org/documentation/

[global]
corner_radius = 0
enable_recursive_icon_lookup = true
# Show on the monitor with keyboard focus instead of always the primary
follow = keyboard
font = DejaVu Sans 12
format = "<b>%s</b>\n%b"
frame_width = 2
gap_size = 8
horizontal_padding = 12
icon_corner_radius = 0
icon_theme = Adwaita
max_icon_size = 48
# Clear Waybar at the top of the screen
offset = (12, 32)
origin = top-right
padding = 10
# Hide the "(A)" and "(U)" title prefixes for notifications with actions or URLs
show_indicators = no
width = (200, 500)

# Use Iceberg (https://cocopon.github.io/iceberg.vim/) colors. Frames are each
# background darkened to 40%
[urgency_low]
background = "#3d425b"
foreground = "#c6c8d1"
frame_color = "#181a24"
timeout = 3

[urgency_normal]
background = "#84a0c6"
foreground = "#161821"
frame_color = "#35404f"
highlight = "#161821"
timeout = 5

# Keep critical notifications (e.g. low battery) until I dismiss them
[urgency_critical]
background = "#e27878"
foreground = "#161821"
frame_color = "#5a3030"
highlight = "#161821"
timeout = 0
