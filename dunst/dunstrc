# Make notifications big and colorful so that I notice them. See all options:
# https://dunst-project.org/documentation/

[global]
corner_radius = 0
enable_recursive_icon_lookup = true
# Show on the monitor with keyboard focus instead of always the primary
follow = keyboard
font = DejaVu Sans 12
format = "<b>%s</b>\n%b"
frame_width = 2
gap_size = 8
horizontal_padding = 12
icon_corner_radius = 0
icon_theme = Adwaita
max_icon_size = 48
# Clear the i3bar at the top of the screen
offset = (12, 32)
origin = top-right
padding = 10
# Hide the "(A)" and "(U)" title prefixes for notifications with actions or URLs
show_indicators = no
width = (200, 500)

[urgency_low]
background = "#45475a"
foreground = "#cdd6f4"
frame_color = "#1b1c24"
timeout = 3

[urgency_normal]
background = "#89b4fa"
foreground = "#1e1e2e"
frame_color = "#364864"
highlight = "#1e1e2e"
timeout = 5

# Keep critical notifications (e.g. low battery) until I dismiss them
[urgency_critical]
background = "#f38ba8"
foreground = "#3d1a22"
frame_color = "#613743"
highlight = "#3d1a22"
timeout = 0
