auto-update = off
bell-audio-volume = 1
bell-features = attention,audio
bold-color = bright
confirm-close-surface = false
cursor-style = bar
cursor-style-blink = true
font-family = "DejaVu Sans Mono"
# Rename tabs without clicking
keybind = ctrl+shift+r=prompt_tab_title
# Only integration feature I'd want is `cursor` which doesn't work in tmux
# https://github.com/ghostty-org/ghostty/discussions/5802#discussioncomment-12218114
shell-integration = none
# Use Modus Vivendi, which Ghostty bundles, for white text on black and ANSI
# colors with at least 7:1 contrast (except 3.0:1 for the dim gray `#595959`)
# https://protesilaos.com/emacs/modus-themes
theme = Modus Vivendi
window-decoration = false
window-padding-x = 2
window-padding-y = 2
working-directory = home
