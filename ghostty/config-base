auto-update = off
bell-audio-volume = 1
bell-features = attention,audio
bold-color = bright
confirm-close-surface = false
cursor-style = bar
cursor-style-blink = true
font-family = "DejaVu Sans Mono"
# Only integration feature I'd want is `cursor` which doesn't work in tmux
# https://github.com/ghostty-org/ghostty/discussions/5802#discussioncomment-12218114
shell-integration = none
# Use Iceberg (https://cocopon.github.io/iceberg.vim/), which Ghostty bundles.
# It sets the background, foreground, cursor, selection, and ANSI palette
theme = Iceberg Dark
window-decoration = false
window-padding-x = 2
window-padding-y = 2
working-directory = home
