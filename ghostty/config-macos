adjust-cell-height = 1
adjust-cell-width = -1
bell-audio-path = /System/Library/Sounds/Glass.aiff
config-file = config-base
font-size = 12
font-thicken = true
# Send the working Alt+arrow shortcuts so that Ctrl+Tab navigation survives tmux
# https://opencode.ai/v2/docs/cli/keybinds#sessions
keybind = ctrl+shift+tab=csi:1;3A
keybind = ctrl+tab=csi:1;3B
# Disable Ghostty's other tab shortcuts so that terminal apps can use these keys
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind
keybind = super+alt+w=unbind
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
keybind = super+t=unbind
# Make Option behave as Alt so it emits Alt-prefixed escape sequences (e.g.
# Alt+Left = `\e[1;3D`, Alt+Backspace = `\e\x7f`). Without this, Option is used
# for typing special characters and word-level keybindings don't work
macos-option-as-alt = true
