#!/usr/bin/env bash

# Shows memory or swap usage. `BLOCK_INSTANCE` is `<source>;<display>`, where
# source is `mem` or `swap` and display is `free`, `used`, `total`, or `perc`

set -eu

IFS=';' read -r source display <<< "${BLOCK_INSTANCE:-mem;free}"

# Print the value as full and short text, then exit 33 to mark the block urgent
# when usage is high
awk -v source="${source}" -v display="${display:-free}" '
  # Collect sizes in kB, e.g. "MemTotal:  16005312 kB"
  { kb[tolower($1)] = $2 }

  END {
    # Count available memory (not just free memory) as free, like `free -h`
    total = kb[source "total:"]
    free = kb[source (source == "mem" ? "available:" : "free:")]
    if (total <= 0) {
      exit
    }
    used = total - free
    perc = int(used * 100 / total)

    # Format value
    if (display == "perc") {
      text = perc "%"
    } else {
      value = display == "used" ? used : display == "total" ? total : free
      split("KB MB GB TB", units, " ")
      for (i = 1; value >= 1024 && i < 4; i++) {
        value /= 1024
      }
      text = sprintf("%.2f %s", value, units[i])
    }
    print text
    print text
    print ""
    exit perc > (source == "swap" ? 50 : 90) ? 33 : 0
  }
' /proc/meminfo
