# Iceberg (https://cocopon.github.io/iceberg.vim/), ported from the GUI colors
# of iceberg.vim's dark highlight groups
color-link color-column "#1e2132"
color-link comment "#6b7089"
color-link constant "#a093c7"
color-link constant.number "#a093c7"
color-link constant.specialChar "#b4be82"
color-link constant.string "#89b8c2"
color-link current-line-number "#cdd1e6,#2a3158"
color-link cursor-line "#1e2132"
color-link default "#c6c8d1,#161821"
color-link diff-added "#b4be82"
color-link diff-deleted "#e27878"
color-link diff-modified "#89b8c2"
color-link divider "#3e445e"
color-link error "#e27878"
color-link gutter-error "#e27878"
color-link gutter-warning "#e2a478"
# Empty fg keeps the default light text, and bg is iceberg.vim's `MatchParen`
# gray. Iceberg's orange `Search` is too loud for the `highlightword` plugin,
# which highlights every occurrence of the word under the cursor. micro's
# renderer replaces the whole cell style for search matches (it can't merge bg
# onto each token's syntax color), so highlighted words show in this fg, not
# their syntax color. Shared with manual Find
color-link hlsearch ",#3e445e"
color-link identifier "#84a0c6"
color-link identifier.class "#84a0c6"
color-link identifier.var "#89b8c2"
color-link indent-char "#242940"
color-link line-number "#444b71,#1e2132"
color-link match-brace "#ffffff,#3e445e"
color-link message "#c6c8d1,#161821"
color-link preproc "#b4be82"
color-link scrollbar "#3e445e,#3e445e"
color-link selection ",#272c42"
color-link special "#b4be82"
color-link statement "#84a0c6"
color-link statusline "#17171b,#818596"
color-link symbol "#84a0c6"
color-link symbol.brackets "#c6c8d1"
color-link symbol.operator "#84a0c6"
color-link symbol.tag "#84a0c6"
color-link tab-error "#e27878"
color-link tabbar "#3e445e,#0f1117"
color-link tabbar.active "#9a9ca5,#161821"
color-link todo "#b4be82,#45493e"
color-link trailingws "#e27878"
color-link type "#84a0c6"
color-link type.keyword "#84a0c6"
color-link underlined "#84a0c6"
