{
  "*.jsx": {
    "colorcolumn": 80
  },
  "basename": true,
  "colorcolumn": 100,
  "colorscheme": "twilight",
  "cursorline": false,
  "diffgutter": true,
  "ft:javascript": {
    "colorcolumn": 80
  },
  "ft:python": {
    "tabsize": 4
  },
  "ft:typescript": {
    "colorcolumn": 80
  },
  "hltaberrors": true,
  "hltrailingws": true,
  "ignorecase": false,
  "linter": false,
  "mkparents": true,
  "reload": "auto",
  "scrollbar": true,
  "showchars": "ispace=▏,itab=▏",
  "softwrap": true,
  "statusformatl": "$(filename)",
  "statusformatr": "$(modified)$(overwrite)($(line),$(col)) $(status.paste)| ft:$(opt:filetype)",
  "tabsize": 2,
  "tabstospaces": true,
  "wordwrap": true
}
