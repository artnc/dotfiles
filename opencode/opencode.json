{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.claude/CLAUDE.md", "~/.claude/RTK.md"],
  "mcp": {
    "servers": {
      "playwright": {
        "command": ["npx", "@playwright/mcp@latest"],
        "type": "local"
      }
    }
  },
  "permissions": [
    { "action": "*", "effect": "allow", "resource": "*" },
    { "action": "read", "effect": "ask", "resource": "*.env" },
    { "action": "read", "effect": "ask", "resource": "*.env.*" },
    { "action": "read", "effect": "allow", "resource": "*.env.example" }
  ],
  "update": "disable"
}
