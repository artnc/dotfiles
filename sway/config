# Mod key
set $mod Mod4

# Font for window titles. `waybar/style.css` repeats it since Waybar ignores it
font pango:DejaVu Sans Mono 9

# Use Modus Vivendi colors to match Ghostty (see `waybar/style.css`). Disable
# focused window styling by giving focused windows the unfocused colors (border,
# background, text, indicator, and child border). Keep Sway's brighter tab for
# the focused window of an unfocused container
set $unfocused_colors #303030 #1e1e1e #989898 #303030 #1e1e1e
client.focused $unfocused_colors
client.focused_inactive #303030 #535353 #ffffff #535353 #535353
client.unfocused $unfocused_colors
client.urgent #303030 #9d1f1f #ffffff #9d1f1f #9d1f1f
# Color wmenu's items white on black like Waybar, and its prompt and selection
# like Waybar's focused workspace
set $wmenu_colors -N 000000 -n ffffff -M 1640b0 -m ffffff -S 1640b0 -s ffffff

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Hide title bars of tiled windows. Tabbed and stacked containers still show
# titles, and floating windows (e.g. dialogs) keep theirs
default_border pixel 0

# kill focused window
bindsym $mod+Shift+apostrophe kill

# start wmenu (a program launcher like dmenu)
bindsym $mod+e exec wmenu-run $wmenu_colors

# change focus
# bindsym $mod+h focus left
# bindsym $mod+t focus down
# bindsym $mod+n focus up
# bindsym $mod+s focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
# bindsym $mod+Shift+h move left
# bindsym $mod+Shift+t move down
# bindsym $mod+Shift+n move up
# bindsym $mod+Shift+s move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+d split h

# split in vertical orientation
bindsym $mod+k split v

# enter fullscreen mode for the focused container
bindsym $mod+u fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+o layout stacking
bindsym $mod+comma layout tabbed
bindsym $mod+period layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# switch to workspace
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

# Switch workspace with the numpad. Omit NumLock's `Mod2`, which i3 needed
# (https://unix.stackexchange.com/a/566593), since Sway ignores locked modifiers
bindsym $mod+KP_1 workspace 1
bindsym $mod+KP_2 workspace 2
bindsym $mod+KP_3 workspace 3
bindsym $mod+KP_4 workspace 4
bindsym $mod+KP_5 workspace 5
bindsym $mod+KP_6 workspace 6
bindsym $mod+KP_7 workspace 7
bindsym $mod+KP_8 workspace 8
bindsym $mod+KP_9 workspace 9
bindsym $mod+KP_0 workspace 10

# switch to previous/next workspace
bindsym $mod+Shift+Tab workspace prev
bindsym $mod+Tab workspace next

# move workspace to left and right monitors
bindsym $mod+Shift+bracketleft move workspace to output left
bindsym $mod+Shift+bracketright move workspace to output right

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# change volume (don't use amixer! see chaidarun.com/arch-notes)
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%

# change screen brightness
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+

# reload the configuration file
bindsym $mod+Shift+j reload
# exit sway (logs you out of your Wayland session). Use Modus Vivendi's warm
# yellow, pale ochre, and intense yellow background
bindsym $mod+Shift+period exec swaynag -t warning --background fec43f --border 7a6100 --border-bottom 7a6100 --button-background e0d38c --button-text 000000 --text 000000 -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        # bindsym h resize shrink width 10 px or 10 ppt
        # bindsym t resize grow height 10 px or 10 ppt
        # bindsym n resize shrink height 10 px or 10 ppt
        # bindsym s resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt

        # back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
}

bindsym $mod+p mode "resize"

bindsym $mod+l exec loginctl lock-session

# Take screenshot of a clicked window or output, or a dragged area. Save it to
# `XDG_PICTURES_DIR` (else `~`) and copy it to the clipboard
bindsym Print exec grimshot --notify savecopy anything

# Pick a clipboard history entry to copy again. Skip `wl-copy` if I cancel,
# since it would copy the empty input over the clipboard
bindsym $mod+v exec sel=$(cliphist list | wmenu -l 10 $wmenu_colors) && echo "$sel" | cliphist decode | wl-copy

# Type email addresses. Sleep first so that typing doesn't start while keys are
# still down. base64-encoded to evade crude GitHub scrapers
bindsym Control+Mod1+c exec sleep 0.3 && wtype $(printf %s YXJ0QGNoYWlkYXJ1bi5jb20= | base64 -d)
bindsym Control+Mod1+d exec sleep 0.3 && wtype $(printf %s YXJ0QGR1b2xpbmdvLmNvbQ== | base64 -d)
bindsym Control+Mod1+e exec sleep 0.3 && wtype $(printf %s YXJ0Y2hhaWRhcnVuQGdtYWlsLmNvbQ== | base64 -d)

# Push to talk with vocalinux via D-Bus. Its own F1 listener needs the `input`
# group on Wayland, which would let every app read all keystrokes
bindsym --no-repeat F1 exec vocalinux --start
bindsym --release F1 exec vocalinux --stop

# Dismiss notification, or show the previous one again
bindsym $mod+grave exec dunstctl close
bindsym $mod+Shift+grave exec dunstctl history-pop

# Start Waybar instead of swaybar since swaybar can't open tray icons' menus
bar {
  swaybar_command waybar
}

# Use Dvorak, plus a QWERTY layout that `aoeu` in `.zshrc` switches to. Remap
# Caps Lock to Super
input type:keyboard {
  xkb_layout us,us
  xkb_numlock enabled
  xkb_options caps:super
  xkb_variant dvorak,
}

# Enable tap-to-click. libinput's default `lrm` button map makes two- and
# three-finger taps right- and middle-click
input type:touchpad {
  tap enabled
}

# Import `DISPLAY`, `WAYLAND_DISPLAY`, etc. into the systemd user env for
# D-Bus-activated apps (e.g. dunst and xdg-desktop-portal-wlr). Do this before
# the execs below so that it starts first. Sway doesn't wait for an `exec` to
# finish, so an app that activates one of them right away could still win
include /etc/sway/config.d/*

# Set wallpaper if this machine has the file. `output * bg` would show an error
# bar on machines without it
exec swaybg -m stretch -i ~/Pictures/Wallpapers/smoke/01.png

# Lock after 9 minutes idle, before sleep, and on `loginctl lock-session`. Turn
# off screens 1 minute after the idle lock
exec swayidle -w timeout 540 swaylock timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep swaylock lock swaylock

# Record clipboard history. cliphist skips entries that apps (e.g. KeePassXC)
# mark as sensitive via `x-kde-passwordManagerHint`
exec wl-paste --watch cliphist store

# Run XDG autostart entries (~/.config/autostart, /etc/xdg/autostart)
exec dex --autostart --environment sway
