# Use Modus Vivendi colors to match Ghostty and dunst
# https://github.com/protesilaos/modus-themes/blob/main/modus-themes.el

# Show yellow backspaces on the ring
bs-hl-color=fec43f
# Use black to match Ghostty and Waybar
color=000000
# Fork once locked so that `swayidle -w` waits for the lock before sleep
daemonize
# Ignore Enter presses that only wake the screen
ignore-empty-password
# Make the inside transparent since these states default to colored fills
inside-clear-color=00000000
inside-ver-color=00000000
inside-wrong-color=00000000
# Show blue keypresses on the ring
key-hl-color=2fafff
# Match the Dvorak/QWERTY layout label to the palette
layout-text-color=ffffff
# Show a yellow ring when cleared, dark gray while idle, blue while verifying,
# and red on failure
ring-clear-color=fec43f
ring-color=303030
ring-ver-color=2fafff
ring-wrong-color=ff5f59
# Hide the lines that separate keypress highlights from the ring
separator-color=00000000
# Replace the default black text, which is invisible on a black background
text-clear-color=fec43f
text-ver-color=2fafff
text-wrong-color=ff5f59
