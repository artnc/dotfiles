#!/usr/bin/env bash
# Prints download and upload speeds in MB/s as Waybar JSON every 5 seconds, e.g.
# "▼ 0.4 ▲  12". Shows one decimal below 10 and none above, which Waybar's
# network module can't do. Counts only physical interfaces (those with a
# `device` link) so that Tailscale and Docker traffic isn't counted twice. Turns
# yellow behind a captive portal and red when offline

set -eu
shopt -s nullglob

# Prints total bytes received and sent by physical interfaces, e.g. "123 456"
totals() {
  local rx=0 tx=0 dev
  for dev in /sys/class/net/*/device; do
    rx=$((rx + $(< "${dev%/device}/statistics/rx_bytes")))
    tx=$((tx + $(< "${dev%/device}/statistics/tx_bytes")))
  done
  echo "${rx} ${tx}"
}

read -r rx tx <<< "$(totals)"
while true; do
  # Check connectivity during the sleep so that each delta still covers 5
  # seconds. Cap `ping` at 4 seconds since it otherwise waits 2 RTTs for a lost
  # reply. Any reply counts as online, so that one dropped packet doesn't flash
  # red. The RTT is empty if no reply came
  sleep 5 &
  connectivity="$(nmcli -t -f CONNECTIVITY general 2> /dev/null || echo unknown)"
  rtt="$(ping -c3 -i0.2 -w4 -q 8.8.8.8 2> /dev/null | awk -F/ '/^rtt/ {printf "%.0f", $5}')"
  wait
  read -r new_rx new_tx <<< "$(totals)"

  # Trust the ping to decide if the internet is reachable, since it's more
  # trustworthy than `nm-applet`. Use NetworkManager's own check only to detect a
  # captive portal. Its "limited" state means no internet (e.g. an ISP outage),
  # so that stays red
  if [[ -n ${rtt} ]]; then
    class=''
  elif [[ ${connectivity} == portal ]]; then
    class='warning'
  else
    class='critical'
  fi

  # Drop a ".0" suffix, then pad to 3 characters so that the module keeps its
  # width. Clamp negative deltas, which happen when an interface disappears
  # (e.g. an unplugged dock)
  awk -v rx=$((new_rx - rx)) -v tx=$((new_tx - tx)) '
    function mb(b) {
      v = (b > 0 ? b : 0) / 5e6
      s = sprintf(v >= 9.95 ? "%.0f" : "%.1f", v)
      sub(/\.0$/, "", s)
      return sprintf("%3s", s)
    }
    BEGIN { print "▼", mb(rx), "▲", mb(tx) }
  ' | jq -cR --arg class "${class}" --arg tooltip "8.8.8.8: ${rtt:-no reply}${rtt:+ ms}, connectivity: ${connectivity}" '{$class, text: ., $tooltip}'
  rx=${new_rx} tx=${new_tx}
done
