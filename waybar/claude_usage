#!/usr/bin/env bash
# Prints Claude usage as Waybar JSON, e.g. "CC 12% 4.6h 41% 2.4d" for the
# session and weekly limits and the time until each resets. Reads the
# `rate_limits` that the Claude Code status line caches (see `statusLine` in
# `claude/settings.json`), since polling api.anthropic.com/api/oauth/usage
# every minute fails with HTTP 429 ("Rate limited. Please try again later.")
# after a few calls

set -eu

cache_file="${HOME}/.cache/claude_rate_limits.json"
# Pad fields to fixed widths so that the module doesn't resize
section_format='%3s%% %4s'

# Print question marks with the reason in the tooltip, then exit
fail() {
  local -r section="$(printf "${section_format}" '?' '?')"
  jq -cn --arg text "CC ${section} ${section}" --arg tooltip "${1}" '{$text, $tooltip}'
  exit 0
}

# Get each window's usage and reset time. Count a window that has reset as 0%
# with an unknown reset time, since the next request starts a new window. Share
# bash's clock so that the seconds until a reset are never negative. Use `-e` to
# fail on an empty file, since jq prints nothing for it and `section()` then
# fails with "arithmetic syntax error"
now_ts="$(date +%s)"
parsed="$(jq -er --argjson now "${now_ts}" '[(.five_hour, .seven_day) | if (.resets_at // 0) > $now then (.used_percentage // 0 | floor), (.resets_at | floor) else 0, "" end] | join(",")' "${cache_file}" 2> /dev/null)" || fail "Can't read ${cache_file}. Start Claude Code and send a message to create it"

# Split on commas instead of tabs, since `read` merges consecutive tabs and
# shifts the fields when a reset time is empty (e.g. no active session)
IFS=, read -r session_pct session_reset weekly_pct weekly_reset <<< "${parsed}"

# Find the seconds until each reset, or nothing if it's unknown
session_left="${session_reset:+$((session_reset - now_ts))}"
weekly_left="${weekly_reset:+$((weekly_reset - now_ts))}"

# Formats a number of seconds like the Claude Code status line: "Xm" under 1h,
# "X.Yh" under 1d, else "X.Yd"
fuzzy_duration() {
  local -r diff="${1}"
  if [[ -z ${diff} ]]; then
    echo '?'
    return
  fi
  if ((diff < 3600)); then
    echo "$((diff / 60))m"
    return
  fi

  # Truncate to tenths of an hour or day
  local unit='h' tenths=$((diff / 360))
  if ((diff >= 86400)); then
    unit='d'
    tenths=$((diff / 8640))
  fi

  # Drop a ".0" suffix to match jq's number formatting, e.g. "5d" instead of "5.0d"
  local suffix=".$((tenths % 10))"
  echo "$((tenths / 10))${suffix%.0}${unit}"
}

# Formats a reset time like the clock module, e.g. "Thu 26 Nov 06:00"
reset_at() {
  if [[ -n ${1} ]] && date -d "@${1}" '+%a %d %b %H:%M'; then
    return
  fi
  echo '?'
}

# Find the percentage of each 5h and 7d window that has elapsed. Count an
# unknown reset time as a finished window, so that it never looks ahead of pace
session_elapsed=$((100 - ${session_left:-0} * 100 / 18000))
weekly_elapsed=$((100 - ${weekly_left:-0} * 100 / 604800))

# Prints a limit's usage and time until reset, colored like the CPU and memory
# modules when usage gets ahead of the elapsed time (e.g. 30% used after 10% of
# the window) or the limit is close. Uses Pango markup with the `.warning` and
# `.critical` colors from `style.css`, since CSS can't style part of a label
section() {
  local -r ahead=$((${1} - ${2})) text="$(printf "${section_format}" "${1}" "$(fuzzy_duration "${3}")")"
  if ((${1} >= 90 || ahead >= 25)); then
    echo "<span color='#ff5f59'>${text}</span>"
  elif ((ahead >= 10)); then
    echo "<span color='#fec43f'>${text}</span>"
  else
    echo "${text}"
  fi
}

# Show the time until each reset in the text, and the pace and exact reset times
# in the tooltip. Omit the pace if the reset time is unknown. Show when the
# cache changed, since it misses usage from other devices until Claude Code here
# sends a message
jq -cn \
  --arg text "CC $(section "${session_pct}" "${session_elapsed}" "${session_left}") $(section "${weekly_pct}" "${weekly_elapsed}" "${weekly_left}")" \
  --arg tooltip "Session: ${session_pct}% used${session_left:+ after ${session_elapsed}% of 5h}, resets $(reset_at "${session_reset}")"$'\n'"Weekly: ${weekly_pct}% used${weekly_left:+ after ${weekly_elapsed}% of 7d}, resets $(reset_at "${weekly_reset}")"$'\n'"Updated $(fuzzy_duration "$((now_ts - $(date -r "${cache_file}" +%s)))") ago" \
  '{$text, $tooltip}'
