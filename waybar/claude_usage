#!/usr/bin/env bash
# Prints Claude.ai usage as Waybar JSON, e.g. "CC 12% 4.6h 41% 2.4d" for the
# session and weekly limits and the time until each resets. Reads `ORG_ID` and
# `SESSION_KEY` from `~/.config/claude-usage/env`. Get `SESSION_KEY` from the
# `sessionKey` cookie at claude.ai (devtools > Application > Cookies)

set -eu

config_file="${HOME}/.config/claude-usage/env"
# Pad fields to fixed widths so that the module doesn't resize
text_format='CC %3s%% %4s %3s%% %4s'

# Print question marks with the reason in the tooltip, then exit
fail() {
  jq -cn --arg text "$(printf "${text_format}" '?' '?' '?' '?')" --arg tooltip "${1}" '{$text, $tooltip}'
  exit 0
}

if [[ ! -r ${config_file} ]]; then
  fail "Can't read ${config_file}"
fi

# shellcheck source=/dev/null
source "${config_file}"

response="$(curl -fsS --max-time 10 --compressed \
  "https://claude.ai/api/organizations/${ORG_ID}/usage" \
  -H 'User-Agent: Mozilla/5.0 (X11; Linux x86_64; rv:150.0) Gecko/20100101 Firefox/150.0' \
  -H 'Accept: */*' \
  -H 'Referer: https://claude.ai/settings/usage' \
  -H 'anthropic-client-platform: web_claude_ai' \
  -H 'content-type: application/json' \
  -H "Cookie: sessionKey=${SESSION_KEY}" 2> /dev/null)" || fail 'Request to claude.ai failed'

parsed="$(echo "${response}" | jq -r \
  '[(.five_hour.utilization | tonumber? // 0 | floor), (.five_hour.resets_at // ""), (.seven_day.utilization | tonumber? // 0 | floor), (.seven_day.resets_at // "")] | @tsv' 2> /dev/null)" || fail "Can't parse the response"

IFS=$'\t' read -r session_pct session_reset weekly_pct weekly_reset <<< "${parsed}"

# Defensive: if the API shape changes and a percentage field arrives non-numeric
# (e.g. a date string leaking through), render it as 0 rather than garbage
[[ ${session_pct} =~ ^[0-9]+$ ]] || session_pct=0
[[ ${weekly_pct} =~ ^[0-9]+$ ]] || weekly_pct=0

now_ts="$(date +%s)"
# Formats time until reset like the Claude Code status line: "Xm" under 1h,
# "X.Yh" under 1d, else "X.Yd"
time_until() {
  local iso="$1"
  if [[ -z ${iso} ]]; then
    echo '?'
    return
  fi
  local reset_ts
  reset_ts="$(date -d "${iso}" +%s 2> /dev/null)" || {
    echo '?'
    return
  }
  local diff=$((reset_ts - now_ts))
  if ((diff < 0)); then
    diff=0
  fi
  if ((diff < 3600)); then
    echo "$((diff / 60))m"
    return
  fi

  # Truncate to tenths of an hour or day
  local unit='h' tenths=$((diff / 360))
  if ((diff >= 86400)); then
    unit='d'
    tenths=$((diff / 8640))
  fi

  # Drop a ".0" suffix to match jq's number formatting, e.g. "5d" instead of "5.0d"
  local suffix=".$((tenths % 10))"
  echo "$((tenths / 10))${suffix%.0}${unit}"
}

# Formats a reset time like the clock module, e.g. "Thu 26 Nov 06:00"
reset_at() {
  if [[ -n ${1} ]] && date -d "${1}" '+%a %d %b %H:%M' 2> /dev/null; then
    return
  fi
  echo '?'
}

# Color the module like the CPU and memory modules when either limit is close
class=''
if ((session_pct >= 90 || weekly_pct >= 90)); then
  class='critical'
elif ((session_pct >= 75 || weekly_pct >= 75)); then
  class='warning'
fi

# Show the time until each reset in the text, and the exact times in the tooltip
jq -cn \
  --arg class "${class}" \
  --arg text "$(printf "${text_format}" "${session_pct}" "$(time_until "${session_reset}")" "${weekly_pct}" "$(time_until "${weekly_reset}")")" \
  --arg tooltip "Session: ${session_pct}%, resets $(reset_at "${session_reset}")"$'\n'"Weekly: ${weekly_pct}%, resets $(reset_at "${weekly_reset}")" \
  '{$class, $text, $tooltip}'
